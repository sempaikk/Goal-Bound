# Copy to .env and fill in values

# Required — bot token from Discord Developer Portal
DISCORD_TOKEN=

# Optional — your Discord user ID (privileged pulls, /reload)
DISCORD_OWNER_ID=

# Optional — guild ID for faster slash command registration during dev
OWNER_GUILD_ID=

# Optional — writable data directory (SQLite + JSON stores).
# Local: leave unset → uses ./data (same as before).
# Railway: set to /app/persist and mount the volume at /app/persist
# PERSIST_DIR=/app/persist
