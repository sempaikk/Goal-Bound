# O npm tem um bug conhecido onde às vezes ignora a flag "gypfile": false
# que o better-sqlite3 usa pra avisar "já tenho um binário pré-compilado,
# não precisa compilar nada". Quando isso acontece, o npm tenta rodar
# node-gyp sem as ferramentas de compilação instaladas, e o install falha.
#
# ignore-scripts=true desativa os scripts de post-install de todos os
# pacotes (não só do better-sqlite3). Isso é seguro aqui porque nenhuma
# das dependências do projeto (better-sqlite3, discord.js, dotenv)
# precisa rodar um script de instalação de verdade - o better-sqlite3
# já vem com o binário certo dentro do próprio pacote baixado.
ignore-scripts=true